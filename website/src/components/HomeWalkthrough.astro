---
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';
import { getAuthoringPrompt } from '../../../src/shared/authoring-guide';
interface Props { lang: Locale }
const { lang } = Astro.props;
const en = lang === 'en';
const capture = (name: string) => `/images/workflow/${name}${en ? '-en' : ''}.jpg`;
const guide = localizePath('/guide/', lang);
const steps = en ? [
  { label: 'Choose a space', title: 'One project. One local folder.', text: 'Open your article folder as a space. Let your usual AI save Markdown there, or save its answer yourself. A few loose files are enough to start; a series can have its own subfolders. For the sample, open the extracted library folder.', mac: 'Mac: unzip in Finder, then use File → Open Folder (⌘ O) to select library.', windows: 'Windows: use Extract All in File Explorer, then File → Open Folder (Ctrl O) to select library.' },
  { label: 'Read closely', title: 'Find the passage that needs more.', text: 'Read at your own pace, alongside a translation if you have one. In this example, “Tell the supplier what you need” never explains what to include. Copy the passage, take a screenshot, or collect a few comments as annotations.', mac: 'Mac: select the passage and press ⌘ C, or capture it with Shift ⌘ 4.', windows: 'Windows: select the passage and press Ctrl C, or capture it with Win Shift S.' },
  { label: 'Ask AI to revise', title: 'Give AI the location and the request.', text: 'Copy “Space instructions for AI” into your usual AI conversation with the passage and your request. With Codex CLI installed and signed in, you can also submit a local task from “Give to AI”. Check its space and article before starting.', mac: 'Mac: paste into your AI chat with ⌘ V, or enter the request in the local Codex task panel.', windows: 'Windows: paste into your AI chat with Ctrl V, or enter the request in the local Codex task panel.' },
  { label: 'Review changes', title: 'Find the changed article. Check what matters.', text: 'After saving, the changed-article filter and markers show what needs your attention. Open “View changes” to compare with the last confirmed version and jump to the passage. Mark it reviewed only after checking; simply opening it keeps the reminder.', mac: 'Mac: save in your editor with ⌘ S if your AI cannot save files; then return to MD Duck.', windows: 'Windows: save in your editor with Ctrl S if your AI cannot save files; then return to MD Duck.' },
  { label: 'Publish & archive', title: 'Approve it, hand it over, keep the source.', text: 'Give the approved files to your publishing tool or an AI with your backend permission. Check the target and preview before authorizing publication. Keep the local originals and archive finished articles in MD Duck; restore them when you need to update.', mac: 'Mac: right-click the article to reveal it in Finder. Back up the whole folder, including hidden review data.', windows: 'Windows: right-click the article to reveal it in File Explorer. Back up the whole folder, including hidden review data.' },
] : [
  { label: '选好空间', title: '一个项目，从一个本地文件夹开始。', text: '把文章文件夹作为空间打开，让常用 AI 把 Markdown 保存到这里，或自己保存它的回答。几篇散稿直接放，系列文章再分子文件夹。使用演示文件时，解压后选择里面的 library 文件夹。', mac: 'Mac：在 Finder 中解压，再用「文件 → 打开文件夹」（⌘ O）选择 library。', windows: 'Windows：在文件资源管理器中「全部解压缩」，再按 Ctrl O 选择 library 文件夹。' },
  { label: '认真读', title: '找到还没有说清楚的那一段。', text: '按自己的节奏读，有译文就对照着看。例如演示文章只说「告诉供应商你的需求」，却没有解释究竟要写哪些信息。复制原段、截张图，或者用批注先记下几处问题。', mac: 'Mac：选中原文按 ⌘ C，或用 Shift ⌘ 4 截取这一段。', windows: 'Windows：选中原文按 Ctrl C，或用 Win Shift S 截取这一段。' },
  { label: '交给 AI 改', title: '位置和要求，一起说清楚。', text: '把「给 AI 的空间说明」复制到常用 AI 对话，再附上原段和要求。如果已安装并登录 Codex CLI，也可从「交给 AI」提交本地任务。开始前，核对这次处理的空间和文章。', mac: 'Mac：按 ⌘ V 粘贴到常用 AI 对话，或在 Codex 本地任务面板填写要求。', windows: 'Windows：按 Ctrl V 粘贴到常用 AI 对话，或在 Codex 本地任务面板填写要求。' },
  { label: '找到改动', title: '改了哪一篇，哪里改了，都回来核对。', text: '文件保存后，用「有改动」筛选找到待检查的文章。打开「查看改动」，与上次确认的版本对照，并定位到正文。读满意了，再选「标为已查看」；仅打开文章不会清除提醒。', mac: 'Mac：AI 没有文件权限时，自己在编辑器按 ⌘ S 保存，再回到 MD Duck。', windows: 'Windows：AI 没有文件权限时，自己在编辑器按 Ctrl S 保存，再回到 MD Duck。' },
  { label: '发布归档', title: '确认好的交出去，原稿留在手里。', text: '把确认好的文件交给发布工具，或有后台权限的 AI；核对目标和预览后，再授权发布。本地保留原稿，完成的文章在 MD Duck 中归档，需要更新时再恢复。', mac: 'Mac：右键文章，在 Finder 中显示；备份整个文件夹，包括隐藏的审阅数据。', windows: 'Windows：右键文章，在文件资源管理器中显示；备份整个文件夹，包括隐藏的审阅数据。' },
];
---
<section class="editorial-walkthrough" id="features" aria-labelledby="home-workflow-title" data-home-walkthrough data-lang={lang}>
  <div class="editorial-walkthrough-heading">
    <p class="editorial-folio" aria-hidden="true">02</p>
    <h2 id="home-workflow-title">{en ? <><span>One article.</span>{' '}<span>A complete review.</span></> : <><span>从一篇文章，</span><span>走到放心发布。</span></>}</h2>
    <p>{en ? 'Start with a local space. Give AI a clear task, then check its work yourself. Reading needs no account or API key; a local Codex task is optional.' : '从本地空间开始，把要求说清楚，再亲自检查 AI 改好的内容。阅读无需账号或 API 密钥；Codex 本地任务按需使用。'}</p>
  </div>
  <div class="editorial-lesson">
    <nav class="editorial-steps" aria-label={en ? 'Review workflow' : '审阅步骤'}>
      <ol>{steps.map((step, index) => <li><a href={`#home-step-${index}`} data-home-step={index} aria-controls={`home-step-${index}`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{step.label}</strong></a></li>)}</ol>
    </nav>
    <div class="editorial-lesson-content">
      {steps.map((step, index) => <section class="editorial-lesson-panel" id={`home-step-${index}`} data-home-panel aria-labelledby={`home-step-title-${index}`}>
        <h3 id={`home-step-title-${index}`}>{step.title}</h3>
        <p>{step.text}</p>
        {index === 0 ? <div class="editorial-file-example" aria-label={en ? 'Example article folder' : '文章目录示例'}>
          <p>library/01-clearer-product-inquiry/</p><ul><li><code>article.md</code><span>{en ? 'English' : '英文'}</span></li><li><code>article.zh.md</code><span>{en ? 'Chinese · optional' : '中文 · 可选'}</span></li></ul>
        </div> : index === 1 || index === 3 ? <figure class="editorial-note-example"><a href={index === 1 ? capture('selection') : capture('change-review')} target="_blank" rel="noopener"><img src={index === 1 ? capture('selection') : capture('change-review')} width="1440" height="940" loading="lazy" alt={index === 1 ? (en ? 'The vague passage selected in the actual MD Duck reader.' : '在真实 MD Duck 阅读器中选中还不够具体的原段落。') : (en ? 'MD Duck comparing the revised sample article with its last confirmed version.' : 'MD Duck 将演示文章的改动与上次确认版本对照。')} /></a><figcaption>{en ? 'Mac beta.10 capture · click to enlarge' : 'Mac beta.10 实际截图 · 点击放大'}</figcaption></figure> : index === 2 ? <div class="editorial-lesson-excerpt"><p class="editorial-excerpt-label">{en ? 'After the space instructions, add the passage and this request' : '附上空间说明和原段后，可以这样说'}</p><blockquote>{en ? '“This is too vague. Explain which product, size, quantity, delivery city and required date to include. Use placeholders for unknown facts. Update both local language files without changing the block IDs.”' : '“这一段太笼统。请说明要写清产品、规格、数量、收货城市和期望日期，未知信息用占位符，不要编造。更新本地中英文文件，保留段落标记。”'}</blockquote><a class="text-link" href={`${guide}#ai-workflow`}>{en ? 'Copy the full revision prompt' : '复制完整的修改提示词'}</a><p class="editorial-task-choice"><a href={`${guide}#ai-location`}>{en ? 'Use any AI' : '使用常用 AI'}</a><span aria-hidden="true"> · </span><a href={`${guide}#codex-tasks`}>{en ? 'Use a local Codex task' : '使用 Codex 本地任务'}</a></p></div> : <div class="editorial-review-list"><p>{en ? 'A clear handoff to your publishing AI' : '交给发布 AI 前，确认这三件事'}</p><ol><li>{en ? 'Which approved local article should it use?' : '以哪份确认好的本地文章为准？'}</li><li>{en ? 'Which backend and page will it publish to?' : '发布到哪个后台、哪个页面？'}</li><li>{en ? 'Have you approved the final content and kept a local copy?' : '最终内容是否确认，本地文件是否保留？'}</li></ol><a class="text-link" href={`${guide}#prompt-publishing`}>{en ? 'Get the publishing handoff prompt' : '获取发布交接提示词'}</a></div>}
        <p class="editorial-system-note" data-home-platform-note="mac">{step.mac}</p>
        <p class="editorial-system-note" data-home-platform-note="windows">{step.windows}</p>
      </section>)}
      <div class="editorial-step-controls" data-home-controls hidden><button type="button" data-home-prev>{en ? 'Previous' : '上一步'}</button><p role="status" aria-live="polite" data-home-status></p><button type="button" data-home-next>{en ? 'Next step' : '下一步'}</button></div>
    </div>
    <aside class="editorial-prompt-sidebar">
      <fieldset class="editorial-system-switch" data-home-platform-control hidden><legend class="sr-only">{en ? 'Your operating system' : '你使用的系统'}</legend><label><input type="radio" name="home-platform" value="mac" checked /><span>Mac</span></label><label><input type="radio" name="home-platform" value="windows" /><span>Windows</span></label></fieldset>
      <div class="editorial-prompt-box">
        <h3>{en ? 'Give your AI the writing rules.' : '复制给 AI 的写作规则'}</h3>
        <p>{en ? 'Use your own AI. Give it a topic and these rules so it can prepare the files for your review.' : '把主题和这份规则交给你常用的 AI，让它按约定准备好文章文件。'}</p>
        <details class="editorial-prompt-details" data-home-prompt-details><summary>{en ? 'Read the full prompt' : '查看完整提示词'}</summary><label class="sr-only" for="home-authoring-prompt">{en ? 'MD Duck authoring prompt' : 'MD Duck 写作提示词'}</label><textarea id="home-authoring-prompt" readonly spellcheck="false" rows="8" data-home-prompt>{getAuthoringPrompt(lang)}</textarea></details>
        <button class="button button-light editorial-copy-prompt" type="button" data-home-copy hidden>{en ? 'Copy writing rules' : '复制写作规则'}</button><p class="editorial-copy-status" role="status" aria-live="polite" data-home-copy-status></p>
      </div>
      <a class="editorial-starter-link" href="/examples/md-duck-workflow.zip" download>{en ? 'Download this example' : '下载这套演示文件'}</a><p class="editorial-starter-note">{en ? 'A local article library, before-and-after text, a revision request and a publishing handoff.' : '包含本地文章库、修改前后原稿、修改要求和发布交接示例。'}</p>
      <a class="text-link editorial-full-guide" href={guide}>{en ? 'Read the complete guide' : '阅读完整使用指南'}</a>
    </aside>
  </div>
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-home-walkthrough]')) {
    root.dataset.enhanced = 'true';
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-home-step]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-home-panel]'));
    const previous = root.querySelector<HTMLButtonElement>('[data-home-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-home-next]')!;
    const status = root.querySelector<HTMLElement>('[data-home-status]')!;
    const en = root.dataset.lang === 'en';
    let current = 0;
    const render = (step: number) => {
      current = Math.max(0, Math.min(panels.length - 1, step));
      panels.forEach((panel, index) => { panel.hidden = index !== current; });
      links.forEach((link, index) => { if (index === current) link.setAttribute('aria-current', 'step'); else link.removeAttribute('aria-current'); });
      previous.disabled = current === 0;
      next.disabled = current === panels.length - 1;
      status.textContent = en ? `${current + 1} of ${panels.length}` : `第 ${current + 1} 步 / 共 ${panels.length} 步`;
    };
    const setPlatform = () => {
      const value = root.querySelector<HTMLInputElement>('input[name="home-platform"]:checked')!.value;
      root.querySelectorAll<HTMLElement>('[data-home-platform-note]').forEach(note => { note.hidden = note.dataset.homePlatformNote !== value; });
    };
    links.forEach((link, index) => link.addEventListener('click', event => { event.preventDefault(); render(index); }));
    previous.addEventListener('click', () => render(current - 1));
    next.addEventListener('click', () => render(current + 1));
    root.querySelectorAll<HTMLInputElement>('input[name="home-platform"]').forEach(input => input.addEventListener('change', setPlatform));
    root.querySelector<HTMLElement>('[data-home-controls]')!.hidden = false;
    root.querySelector<HTMLElement>('[data-home-platform-control]')!.hidden = false;
    const initialStep = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
    render(initialStep < 0 ? 0 : initialStep);
    setPlatform();
    const copy = root.querySelector<HTMLButtonElement>('[data-home-copy]')!;
    const prompt = root.querySelector<HTMLTextAreaElement>('[data-home-prompt]')!;
    const copyStatus = root.querySelector<HTMLElement>('[data-home-copy-status]')!;
    const details = root.querySelector<HTMLDetailsElement>('[data-home-prompt-details]')!;
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(prompt.value);
        copyStatus.textContent = en ? 'Copied. Paste into your AI, then add your topic.' : '已复制。粘贴给你的 AI，再填上主题。';
      } catch {
        details.open = true;
        prompt.focus(); prompt.select();
        copyStatus.textContent = en ? 'Text selected. Press ⌘ C on Mac or Ctrl C on Windows to copy.' : '已选中文字。请按 Mac 的 ⌘ C 或 Windows 的 Ctrl C 复制。';
      }
    });
    window.addEventListener('hashchange', () => {
      const index = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
      if (index >= 0) render(index);
    });
  }
</script>

---
import { localizePath, type Locale } from '../i18n';
import PreviewNotice from './PreviewNotice.astro';
import SpaceScreenshot from './SpaceScreenshot.astro';
interface Props { lang: Locale }
const { lang } = Astro.props;
const en = lang === 'en';
const guide = localizePath('/guide/', lang);
const features = en ? [
  { title: 'A space for each kind of writing.', text: 'Keep everyday drafts, a long series and bilingual reviews in their own local folders. Add the folders as spaces and switch by name, without copying your files.', link: 'spaces', action: 'Organize your folders' },
  { title: 'Return to where you were reading.', text: 'Each space keeps its last article, reading position and reading preferences. You can also open a space in its own window.', link: 'spaces', action: 'See how spaces work' },
  { title: 'Give AI the right place to work.', text: 'Copy a space’s instructions into your usual AI, or start a local Codex task. Check the folder and article first; switching your reading space leaves the task on its original target.', link: 'ai-location', action: 'See the AI handoff' },
] : [
  { title: '不同的文章，各有一个位置。', text: '日常草稿、一个长系列、双语审阅，各用自己的本地文件夹。把这些文件夹添加为空间，按名称切换，不必复制一遍文章。', link: 'spaces', action: '按文件夹整理空间' },
  { title: '切回来，接着上次的地方读。', text: '每个空间分别记住上次文章、阅读位置和阅读偏好。需要并排处理时，也可以在独立窗口中打开。', link: 'spaces', action: '了解空间怎么用' },
  { title: '交给 AI 时，先把位置说清楚。', text: '把空间说明复制给常用 AI，或启动 Codex 本地任务。先核对目录和文章；你切去读其他空间，任务仍处理原来的目标。', link: 'ai-location', action: '了解如何交给 AI' },
];
---
<section class="spaces-preview" id="spaces-preview" aria-labelledby="spaces-preview-title">
  <header class="spaces-preview-heading">
    <p class="eyebrow">{en ? 'Your local article spaces' : '本地文章，各有空间'}</p>
    <h2 id="spaces-preview-title">{en ? <>More articles.<br />Still your own folders.</> : <>文章多起来，<br />也有自己的秩序。</>}</h2>
    <p>{en ? 'Keep your local folders as the source of truth. Spaces make it easier to move between subjects, resume reading and give AI a precise task.' : '本地文件夹仍是文章的家。空间让你在不同主题之间切换，接着读，也能把具体的改稿任务交给 AI。'}</p>
  </header>
  <PreviewNotice lang={lang} />
  <p><a class="text-link" href={`${guide}#spaces`}>{en ? 'Try the three-folder example' : '用三分类示例跟着做'}</a></p>
  <SpaceScreenshot lang={lang} capture="overview" />
  <div class="spaces-feature-list">{features.map(feature => <article><h3>{feature.title}</h3><p>{feature.text}</p><a class="text-link" href={`${guide}#${feature.link}`}>{feature.action}</a></article>)}</div>
  <div class="spaces-handoff">
    <div><p class="eyebrow">{en ? 'A focused handoff' : '一次任务，一个明确目标'}</p><h3>{en ? 'Let AI revise. Keep the final say.' : '让 AI 改，最后仍由你判断。'}</h3><p>{en ? 'A local Codex task needs an installed, signed-in Codex CLI. Submit a specific request, answer its approval requests, then return to the saved files for review. It does not publish your article automatically.' : 'Codex 本地任务需要已安装并登录的 Codex CLI。提交具体要求，按需处理审批，完成后回到保存的文件复核。任务不会自动把文章发布出去。'}</p><a class="text-link" href={`${guide}#codex-tasks`}>{en ? 'Read the local-task walkthrough' : '查看本地任务用法'}</a></div>
    <SpaceScreenshot lang={lang} capture="codex" />
  </div>
</section>

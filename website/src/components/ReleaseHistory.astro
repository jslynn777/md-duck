---
import type { Locale } from '../i18n';
import { localizePath } from '../i18n';
import { releaseHistory } from '../data/history';
import { release } from '../data/release';
import '../styles/release-history.css';
interface Props { lang: Locale }
const { lang } = Astro.props;
const en = lang === 'en';
const dateLabel = (date: string) => new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', {
  year: 'numeric', month: en ? 'short' : '2-digit', day: '2-digit', timeZone: 'Asia/Shanghai',
}).format(new Date(`${date}T12:00:00+08:00`));
---
<section class="release-history" id="history" aria-labelledby="history-title" data-release-history>
  <header class="release-history-heading">
    <div><p class="eyebrow">{en ? 'The release journal' : 'MD Duck 的成长记录'}</p><h2 id="history-title">{en ? 'A little easier,\none release at a time.' : '一路读到这里。'}</h2></div>
    <p>{en ? 'From checking one article to keeping several projects in view. Here are the public releases along the way.' : '从认真读完一篇文章，到照顾好几个项目。把已经走过的几步，记在这里。'}</p>
  </header>
  <ol class="release-history-list">
    {releaseHistory.map(item => {
      const current = release.status === 'published' && release.version === item.version;
      return <li class:list={{ 'release-history-current': current }} data-history-version={item.version}>
        <div class="release-history-date"><time datetime={item.publishedAt}>{dateLabel(item.date)}</time><span class="release-history-tick" aria-hidden="true"></span></div>
        <div class="release-history-version"><span>{item.version.replace('0.1.0-', '')}</span>{current && <span class="release-history-current-label">{en ? 'Current download' : '当前下载版本'}</span>}</div>
        <h3>{item.title[lang]}</h3>
        <p>{item.description[lang]}</p>
        <a href={`https://github.com/jslynn777/md-duck/releases/tag/v${item.version}`} class="text-link">{en ? 'Release notes' : '查看发布记录'}<span class="sr-only"> · {item.version}</span></a>
      </li>;
    })}
  </ol>
  <footer class="release-history-footer"><p>{en ? 'The files remain yours. The final reading remains yours, too.' : '文章一直在本地，最后一遍始终由你来读。'}</p><a class="text-link" href={localizePath('/download/', lang)}>{en ? 'Get the current release' : '下载当前版本'}</a></footer>
</section>

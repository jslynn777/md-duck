---
import Layout from '../layouts/Layout.astro';
import { Content as ChineseGuide } from '../content/guide.md';
import { Content as EnglishGuide } from '../content/guide.en.md';
import { localizePath, type Locale } from '../i18n';
import { release } from '../data/release';
import GuideWalkthrough from './GuideWalkthrough.astro';
import SpacesGuide from './SpacesGuide.astro';
interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const sections = [
  ['choose-workflow', en ? 'Choose your starting point' : '选一种开始方式'],
  ['quickstart', en ? 'Try the workflow' : '操作演示'],
  ['file-rules', en ? 'File rules' : '文件存放规则'],
  ['ai-workflow', en ? 'Prompts for your AI' : '给 AI 的提示词'],
  ['spaces', en ? 'Article spaces' : '文章空间'],
  ['choose-ai', en ? 'Two ways to work with AI' : '两种 AI 用法'],
  ['ai-location', en ? 'Locate articles for AI' : 'AI 文章定位'],
  ['codex-tasks', en ? 'Local Codex tasks' : 'Codex 本地任务'],
  ['install', en ? 'Install on Mac' : 'Mac 安装'],
  ['install-windows', en ? 'Install on Windows' : 'Windows 安装'],
  ['open', en ? 'Open an article' : '打开文章'],
  ['review-workflow', en ? 'A comfortable review routine' : '舒服的审阅节奏'],
  ['changes', en ? 'Review changed articles' : '找到改动并复核'],
  ['library', en ? 'Folders and archiving' : '文件夹与归档'],
  ['bilingual', en ? 'Read in two languages' : '双语对照'],
  ['pairing-check', en ? 'Check paragraph pairing' : '检查段落配对'],
  ['notes', en ? 'Add annotations' : '写批注'],
  ['words', en ? 'Understand a word' : '理解单词'],
  ['speech', en ? 'Listen as you read' : '英文朗读'],
  ['ai-setup', en ? 'Connect an AI service' : '连接 AI 服务'],
  ['privacy', en ? 'Data and network use' : '数据与联网'],
  ['faq', en ? 'Common questions' : '常见问题'],
];
const Content = en ? EnglishGuide : ChineseGuide;
---
<Layout lang={lang}
  title={en ? 'Guide · MD Duck' : '使用指南 · MD Duck'}
  description={en ? 'Organize local article spaces, work with any AI or optional Codex tasks, and review saved changes before publishing. A practical Mac and Windows guide with examples and prompts.' : '从散稿、系列到多个文章空间，学会让任意 AI 找准文件，或使用可选 Codex 任务，再找到改动逐篇复核。附 Mac、Windows 步骤、演示文件和提示词。'}>
  <header class="page-heading page-intro wrap">
    <p class="eyebrow">{en ? 'Guide' : '使用指南'}</p>
    <h1>{en ? 'Your files. One place to review.' : '本地写作，集中审阅。'}</h1>
    <p>{en ? 'Start with one local folder. Add separate spaces when your projects grow. Let your AI write, find what changed, and take time to review before publishing. The same file workflow works on Mac and Windows.' : '先从一个本地文件夹开始，项目多了再分别添加为空间。让 AI 写，找到改动，认真复核后再发布。Mac 与 Windows 都沿用这套文件流程。'}</p>
    <a class="text-link" href={`${localizePath('/', lang)}#scenarios`}>{en ? 'Explore loose drafts, series and other ways to use it' : '看看零散文章、系列和其他使用场景'}</a>
  </header>
  <div class="guide-layout wrap">
    <aside class="guide-sidebar guide-toc">
      <nav class="guide-nav-desktop" aria-label={en ? 'On this page' : '本页目录'}><p>{en ? 'On this page' : '本页内容'}</p>{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
      <details class="guide-nav-mobile">
        <summary>{en ? 'On this page' : '本页目录'}</summary>
        <nav aria-label={en ? 'On this page' : '本页目录'}>{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
      </details>
      <a class="sample-link" href="/examples/md-duck-workflow.zip" download>{en ? 'Download the workflow example' : '下载流程演示文件'} <span aria-hidden="true">↓</span></a>
    </aside>
    <article class="prose guide-content">
      <p class="notice">{en ? `This guide covers ${release.version}: local article spaces, reading and review, and optional Codex tasks. ` : `本指南对应 ${release.version}：本地文章空间、阅读与审阅，以及可选的 Codex 任务。`}{release.status === 'preparing' && (en ? 'Public installers are still being prepared. ' : '公开安装包仍在准备。')}<a href={localizePath('/download/', lang)}>{en ? 'See release status' : '查看发布状态'}</a> · <a href="#spaces">{en ? 'Set up your spaces' : '开始设置文章空间'}</a></p>
      <section class="guide-entry" id="choose-workflow" aria-labelledby="choose-workflow-title">
        <p class="eyebrow">{en ? 'Start where you are' : '从你现在的文章开始'}</p>
        <h2 id="choose-workflow-title">{en ? 'How are your articles organized?' : '你的文章，现在放在哪里？'}</h2>
        <div class="guide-entry-list">
          <a href="#quickstart"><strong>{en ? 'A few loose drafts' : '先读几篇散稿'}</strong><span>{en ? 'Put your .md files in one folder. Open it and start reading; add structure later.' : '几份 .md 放进一个文件夹，打开就能读。以后再整理也来得及。'}</span><small>{en ? 'Follow the five-step example' : '跟着五步演示试一次'}</small></a>
          <a href="#library"><strong>{en ? 'One growing series' : '管理一个系列'}</strong><span>{en ? 'Keep each article with its translation and images. Number folders to show the reading order.' : '每篇文章与译文、图片放在一起，用文件夹编号表达篇目顺序。'}</span><small>{en ? 'Set up folders and ordering' : '查看目录与排序方法'}</small></a>
          <a href="#spaces"><strong>{en ? 'Several ongoing projects' : '同时处理多个项目'}</strong><span>{en ? 'Add independent folders as spaces. Switch by name and resume where you were reading.' : '把独立目录分别添加为空间，按名称切换，接着上次的位置读。'}</span><small>{en ? 'Set up article spaces' : '设置文章空间'}</small></a>
        </div>
        <p class="guide-entry-note">{en ? 'All three use your real local files. Choose the amount of organization you need today.' : '这三种方式都直接使用本地文件。按你目前的需要开始就好。'}</p>
      </section>
      <GuideWalkthrough lang={lang} />
      <SpacesGuide lang={lang} />
      <Content />
      <div class="guide-end"><p>{en ? 'Try one complete round: open a space, read a passage, request a change, then review what was saved.' : '先完成一轮：打开空间，读一段，提出修改要求，再检查保存后的结果。'}</p><a class="text-link" href="/examples/md-duck-workflow.zip" download>{en ? 'Download the workflow example' : '下载流程演示文件'} <span aria-hidden="true">↓</span></a></div>
    </article>
  </div>
</Layout>

<style>
  .guide-entry { margin: 34px 0 48px; }
  .guide-entry > h2 { margin-top: 10px; }
  .guide-entry-list { border-block: 1px solid var(--line); margin-top: 24px; }
  .guide-entry-list a { display: grid; grid-template-columns: minmax(150px,.8fr) minmax(0,1.8fr); gap: 6px 26px; padding: 23px 0; text-decoration: none; color: var(--ink); }
  .guide-entry-list a + a { border-top: 1px solid var(--line); }
  .guide-entry-list strong { font: 600 21px/1.5 var(--serif); }
  .guide-entry-list span { font-size: 16px; line-height: 1.8; color: var(--muted); }
  .guide-entry-list small { grid-column: 2; color: var(--accent); font-size: 14px; text-decoration: underline; text-underline-offset: 4px; }
  .guide-entry-list a:hover strong { color: var(--accent); }
  .guide-entry-list a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  .guide-entry .guide-entry-note { font-size: 14px; color: var(--muted); margin-top: 17px; }
  @media (max-width:620px) {
    .guide-entry { margin: 25px 0 36px; }
    .guide-entry-list a { display: flex; flex-direction: column; gap: 8px; padding: 21px 0; }
    .guide-entry-list strong { font-size: 20px; }
  }
</style>

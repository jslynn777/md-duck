---
import Layout from '../layouts/Layout.astro';
import { Content as ChineseGuide } from '../content/guide.md';
import { Content as EnglishGuide } from '../content/guide.en.md';
import { localizePath, type Locale } from '../i18n';
import { release } from '../data/release';
import GuideWalkthrough from './GuideWalkthrough.astro';
interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const sections = [
  ['quickstart', en ? 'Try the workflow' : '操作演示'],
  ['review-workflow', en ? 'Your everyday workflow' : '日常使用场景'],
  ['file-rules', en ? 'File rules' : '文件存放规则'],
  ['ai-workflow', en ? 'Prompts for your AI' : '给 AI 的提示词'],
  ['install', en ? 'Install on Mac' : 'Mac 安装'],
  ['install-windows', en ? 'Install on Windows' : 'Windows 安装'],
  ['open', en ? 'Open an article' : '打开文章'],
  ['changes', en ? 'Review changed articles' : '找到改动并复核'],
  ['library', en ? 'Folders and archiving' : '文件夹与归档'],
  ['bilingual', en ? 'Read in two languages' : '双语对照'],
  ['pairing-check', en ? 'Check paragraph pairing' : '检查段落配对'],
  ['notes', en ? 'Add annotations' : '写批注'],
  ['words', en ? 'Understand a word' : '理解单词'],
  ['speech', en ? 'Listen as you read' : '英文朗读'],
  ['ai-setup', en ? 'Connect an AI service' : '连接 AI 服务'],
  ['privacy', en ? 'Data and network use' : '数据与联网'],
  ['faq', en ? 'Common questions' : '常见问题'],
];
const Content = en ? EnglishGuide : ChineseGuide;
---
<Layout lang={lang}
  title={en ? 'Guide · MD Duck' : '使用指南 · MD Duck'}
  description={en ? 'Write local articles with any AI, read in MD Duck, send screenshots or passages back for revision, and review before publishing. Mac and Windows instructions included.' : '用任何 AI 写本地文章，在 MD Duck 阅读，把截图或原文交回修改，再复核和发布。附 Mac、Windows 用法和 AI 提示词。'}>
  <header class="page-heading page-intro wrap">
    <p class="eyebrow">{en ? 'Guide' : '使用指南'}</p>
    <h1>{en ? 'Your files. One place to review.' : '本地写作，集中审阅。'}</h1>
    <p>{en ? 'Use any AI to write and revise. Read the local files in MD Duck, send unclear passages back, and publish after you are happy with the result. The same workflow works on Mac and Windows.' : '让任何 AI 写和改，在 MD Duck 阅读本地文件，把不满意的段落交回修改。读满意了再发布，本地仍有原稿。Mac 与 Windows 都可以这样用。'}</p>
    <a class="text-link" href={`${localizePath('/', lang)}#scenarios`}>{en ? 'Explore loose drafts, series and other ways to use it' : '看看零散文章、系列和其他使用场景'}</a>
  </header>
  <div class="guide-layout wrap">
    <aside class="guide-sidebar guide-toc">
      <nav class="guide-nav-desktop" aria-label={en ? 'On this page' : '本页目录'}><p>{en ? 'On this page' : '本页内容'}</p>{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
      <details class="guide-nav-mobile">
        <summary>{en ? 'On this page' : '本页目录'}</summary>
        <nav aria-label={en ? 'On this page' : '本页目录'}>{sections.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}</nav>
      </details>
      <a class="sample-link" href="/examples/md-duck-workflow.zip" download>{en ? 'Download the workflow example' : '下载流程演示文件'} <span aria-hidden="true">↓</span></a>
    </aside>
    <article class="prose guide-content">
      <p class="notice">{en ? `This guide covers the free ${release.version} beta. ` : `本指南对应免费测试版 ${release.version}。`}{release.status === 'preparing' && (en ? 'Public installers are still being prepared. ' : '公开安装包仍在准备。')}<a href={localizePath('/download/', lang)}>{en ? 'See release status' : '查看发布状态'}</a></p>
      <GuideWalkthrough lang={lang} />
      <Content />
      <div class="guide-end"><p>{en ? 'Start with the demo: read a paragraph, ask for a focused revision, then check it.' : '从演示文件开始：读一段，提一个具体修改要求，再回来复核。'}</p><a class="text-link" href="/examples/md-duck-workflow.zip" download>{en ? 'Download the workflow example' : '下载流程演示文件'} <span aria-hidden="true">↓</span></a></div>
    </article>
  </div>
</Layout>

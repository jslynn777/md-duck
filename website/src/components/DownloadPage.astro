---
import Layout from '../layouts/Layout.astro';
import { release } from '../data/release';
import { localizePath, type Locale } from '../i18n';
interface Props { lang?: Locale }
const { lang = 'zh' } = Astro.props;
const en = lang === 'en';
const available = release.status === 'published' && release.artifacts.length > 0;
const platforms = {
  'mac-dmg': {
    title: en ? 'Mac · Apple Silicon' : 'Mac · 苹果芯片',
    requirement: en ? 'macOS 13 or later · M-series chips · DMG' : 'macOS 13 或以上 · M 系列芯片 · DMG',
    action: en ? 'Download for Mac' : '下载 Mac 版',
    guide: 'install',
  },
  'windows-setup': {
    title: 'Windows · x64',
    requirement: en ? 'Windows 10 or later · 64-bit Intel / AMD · EXE installer' : 'Windows 10 或以上 · 64 位 Intel / AMD · EXE 安装包',
    action: en ? 'Download for Windows' : '下载 Windows 版',
    guide: 'install-windows',
  },
};
---
<Layout lang={lang}
  title={en ? 'Download · MD Duck' : '下载 · MD Duck'}
  description={en ? 'Download the free MD Duck beta for Apple Silicon Macs and Windows x64. Find system requirements, installation steps, checksums and source code.' : '下载免费的 MD Duck 测试版，适用于苹果芯片 Mac 和 Windows x64。查看系统要求、安装步骤、校验值和源代码。'}>
  <header class="page-heading page-intro wrap">
    <p class="eyebrow">{en ? 'Download' : '下载'}</p>
    <h1>{available ? (en ? 'Start reading on your computer.' : '下载，开始读自己的文章。') : (en ? 'The next free beta is being prepared.' : '新版免费测试版准备中。')}</h1>
    <p>{available ? (en ? 'Choose the installer for your computer. MD Duck is free and open source; AI services are optional and use your own account.' : '选择适合电脑的安装包。MD Duck 免费开源；AI 功能按需连接，使用你自己的服务账户。') : (en ? 'Mac and Windows installers will appear here after the release checks are complete. You can explore the guide and sample while they are being prepared.' : 'Mac 和 Windows 安装包完成发布检查后，会在这里提供。现在可以先了解指南和示例。')}</p>
  </header>
  <div class="release-layout download-layout wrap">
    <section class="release-card status-panel" aria-labelledby="release-title" data-release-version={release.version} data-release-status={release.status} data-release-source-url={release.sourceUrl ?? ''}>
      <div class="release-topline"><span class="status-label">{en ? 'Free beta' : '免费测试版'}</span><span>v{release.version}</span></div>
      <h2 id="release-title">MD Duck</h2>
      <p>{en ? 'A local Markdown reader for close reading and review. Read English alongside Chinese, look up words and leave comments beside the passages.' : '本地 Markdown 精读与审阅工具。对照中英译文、查词，把意见留在原句旁。'}</p>
      {available ? <ul class="artifact-list">{release.artifacts.map(artifact => {
        const platform = platforms[artifact.kind];
        return <li data-release-kind={artifact.kind} data-release-size={artifact.size} data-release-sha256={artifact.sha256}>
          <h3>{platform.title}</h3>
          <p class="artifact-requirement">{platform.requirement}</p>
          <a class="button button-dark" href={artifact.url} data-release-download="true">{platform.action} <span aria-hidden="true">↓</span></a>
          <p class="artifact-details"><span>{artifact.size}</span><a class="text-link" href={`${localizePath('/guide/', lang)}#${platform.guide}`}>{en ? 'Installation steps' : '安装步骤'}</a></p>
          <details><summary>{en ? 'SHA-256 checksum' : '校验值 SHA-256'}</summary><code>{artifact.sha256}</code></details>
        </li>;
      })}</ul> : <div class="release-unavailable"><p>{en ? 'Public installers are being prepared' : '公开安装包准备中'}</p><span>{en ? 'No release file is available to download yet.' : '当前没有可下载的发布文件。'}</span></div>}
      <p class="beta-note">{en ? 'This is an early beta. Keep a copy of your articles and their .review folders before updating. Intel Macs, Windows ARM and Linux builds are not provided.' : '这是早期测试版，更新前请保留文章和旁边 .review 目录的副本。暂未提供 Intel Mac、Windows ARM 和 Linux 安装包。'}</p>
      <div class="download-actions"><a class="text-link" href={localizePath('/guide/', lang)}>{en ? 'Read the guide' : '使用指南'} <span aria-hidden="true">→</span></a><a class="text-link" href="/examples/a-slower-morning.zip" download>{en ? 'Sample article' : '下载示例文章'} <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="release-progress" aria-labelledby="progress-title">
      <p class="eyebrow">{en ? 'Before you install' : '安装前了解'}</p>
      <h2 id="progress-title">{en ? 'A few things to know.' : '把几件事说清楚。'}</h2>
      <ul>
        <li><h3>{en ? 'Free to use' : '免费使用'}</h3><p>{en ? 'Reading, annotations, existing translations and local speech are free. AI explanations and translation use your own provider account and credit. Speech downloads its model on first use.' : '阅读、批注、已有译文对照和本地朗读免费使用。AI 解释与翻译使用你自己的服务账户及额度；首次朗读需要下载语音模型。'}</p></li>
        <li><h3>{en ? 'First launch on Mac' : 'Mac 首次打开'}</h3><p>{en ? 'The beta has an ad-hoc signature, without Apple Developer ID signing or notarization. macOS may block its first launch. Follow the installation guide to allow this app after checking the download source.' : '测试版有 ad-hoc 临时签名，没有 Apple Developer ID 签名或苹果公证。macOS 可能拦截首次启动。确认下载来源后，可按安装指南允许打开此程序。'} <a class="text-link" href={`${localizePath('/guide/', lang)}#install`}>{en ? 'Mac installation' : 'Mac 安装步骤'}</a></p></li>
        <li><h3>{en ? 'Windows installation and speech' : 'Windows 安装与朗读'}</h3><p>{en ? 'The unsigned installer runs per user. Windows may show a publisher warning. Local speech also needs the Microsoft Visual C++ v14 x64 runtime; reading and annotations do not require it.' : '安装包未进行发布者签名，采用每用户安装，Windows 可能显示来源提示。本地朗读另需 Microsoft Visual C++ v14 x64 运行库；普通阅读和批注不需要这一步。'} <a class="text-link" href={`${localizePath('/guide/', lang)}#install-windows`}>{en ? 'Windows installation' : 'Windows 安装步骤'}</a></p></li>
        <li><h3>{en ? 'What has been checked' : '验证范围'}</h3><p>{en ? 'Mac builds have been checked on one Mac. Windows builds passed automated tests, installation, startup restoration and offline synthesis with all five voices. Hands-on Windows desktop use and speaker playback have not been validated. The first model download depends on your network.' : 'Mac 在一台电脑上验证。Windows 已通过自动化测试、安装、启动恢复及五声音离线合成检查；Windows 手动桌面操作和扬声器播放尚未验收。首次模型下载受网络影响。'}</p></li>
      </ul>
    </section>
  </div>
  <section class="source-section wrap" id="source" aria-labelledby="source-title">
    <div><p class="eyebrow">{en ? 'Source code' : '开源'}</p><h2 id="source-title">{en ? 'Read the code. Share your feedback.' : '查看代码，分享反馈。'}</h2></div>
    <div><p>{en ? 'MD Duck uses GPL-3.0-or-later. The public repository includes the project license and third-party notices. Report an issue with your app version, system version and the steps that reproduce it.' : 'MD Duck 采用 GPL-3.0-or-later。公开仓库包含项目许可证与第三方声明。反馈问题时，请附上程序版本、系统版本和复现步骤。'}</p>{release.repositoryUrl && <a class="text-link" href={release.repositoryUrl} target="_blank" rel="noopener noreferrer">{en ? 'View source code' : '查看源代码'} <span aria-hidden="true">↗</span></a>}{available && release.sourceUrl && <a class="text-link source-download-link" href={release.sourceUrl} data-release-source="true">{en ? 'Corresponding source & speech build materials' : '对应源码与朗读构建材料'} <span aria-hidden="true">↓</span></a>}</div>
  </section>
</Layout>
